# `build/*` rather than `build/`: git cannot re-include a file whose PARENT DIRECTORY is
# excluded, so `build/` plus `!build/*.ini` silently failed to track the ini template at all.
build/*
!build/*.ini

*.o
*.a
*.so
compile_commands.json
.cache/

# Deployed config carries real values; the template in build/ is what is tracked.
KnurLogger.ini
!build/KnurLogger.ini

# Session data never belongs in the repo.
sessions/
*.csv
*.log

boot-audit-*.txt

# Office lock files.
~$*

# Byte-compiled caches. Tools/ is a set of standalone scripts run by path, but
# importing one as a module - which is how its reduction gets reused - leaves
# these behind.
__pycache__/
